[Unit]
Description=opencode calendar reminder watcher (due calendar note -> agent reminder run)
After=opencode-serve.service
Requires=opencode-serve.service

[Service]
ExecStart=/usr/bin/python3 /home/roni-saguey/.local/bin/oc_calendar_wake.py
Restart=always
RestartSec=5
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
